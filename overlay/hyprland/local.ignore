# Per-machine files. Never exported into the overlay, never committed.
# One glob per line, relative to the upstream repository root.

# Generated by hypr/hyprland/scripts/display/apply-{monitors,workspaces}.sh from
# ~/.config/settings/quickshell/config.json. Machine-specific by definition.
dots/.config/hypr/monitors.lua
dots/.config/hypr/workspaces.lua
dots/.config/hypr/monitors.conf
dots/.config/hypr/workspaces.conf

# Context for a Claude Code session opened in the clone: what is safe to edit
# there, and that commits made in `mine` are discarded on the next rebuild.
# Lives in the clone rather than this repo because that is where it is read.
CLAUDE.md

# Regenerated by matugen from the wallpaper on every colour change — see the
# [templates.*] output_path entries in ~/.config/matugen/config.toml.
#
# ~/.config/hypr and ~/.config/fuzzel are symlinks into the clone, so matugen
# writes straight into it. Without these lines every wallpaper change leaves the
# clone dirty, and 'export' bakes one wallpaper's palette into the patches — it
# would then travel in the repo and conflict on every upstream merge.
dots/.config/hypr/hyprland/colors.lua
dots/.config/hypr/hyprlock/colors.conf
dots/.config/fuzzel/fuzzel_theme.ini
