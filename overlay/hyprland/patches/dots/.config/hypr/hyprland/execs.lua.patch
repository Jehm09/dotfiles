diff --git a/dots/.config/hypr/hyprland/execs.lua b/dots/.config/hypr/hyprland/execs.lua
index 23f76682..db4d55c9 100644
--- a/dots/.config/hypr/hyprland/execs.lua
+++ b/dots/.config/hypr/hyprland/execs.lua
@@ -1,6 +1,10 @@
 -- put former exec-once commands inside the func and former exec commands outside
 hl.on("hyprland.start", function ()
 
+    -- Display config watcher: aplica cambios de monitores/workspaces del
+    -- config.json automáticamente cuando quickshell lo guarda.
+    hl.exec_cmd("$HOME/.config/hypr/hyprland/scripts/display/watch.sh")
+
     -- Bar, wallpaper
     hl.exec_cmd("$HOME/.config/hypr/hyprland/scripts/start_geoclue_agent.sh")
     hl.exec_cmd("qs -c $qsConfig")
@@ -9,17 +13,28 @@ hl.on("hyprland.start", function ()
     -- Core components (authentication, lock screen, notification daemon)
     hl.exec_cmd("gnome-keyring-daemon --start --components=secrets")
     hl.exec_cmd("hypridle")
+    hl.exec_cmd("$HOME/.config/hypr/hyprland/scripts/hypridle-watch.sh")
+    -- Puente fiable de inhibición de idle (fullscreen/juegos + botón keep-awake):
+    -- pausa hypridle cuando aplica. Ver scripts/idle-inhibit-guard.sh.
+    hl.exec_cmd("$HOME/.config/hypr/hyprland/scripts/idle-inhibit-guard.sh")
     hl.exec_cmd("dbus-update-activation-environment --all")
-    hl.exec_cmd("sleep 1 && dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP") -- Some fix idk
+    -- Push the environment into the systemd user manager and start the session.
+    -- hyprland-session.target activates graphical-session.target, which lets
+    -- xdg-desktop-portal start (its Requisite=). Without this, no app receives
+    -- org.freedesktop.appearance/color-scheme and they don't follow the system theme.
+    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE && systemctl --user start hyprland-session.target")
 
     -- Audio
     hl.exec_cmd("easyeffects --hide-window --service-mode")
 
     -- Clipboard: history
     --hl.exec_cmd("wl-paste --watch cliphist store")
-    hl.exec_cmd("wl-paste --type text --watch bash -c 'cliphist store && qs -c $qsConfig ipc call cliphistService update'")
-    hl.exec_cmd("wl-paste --type image --watch bash -c 'cliphist store && qs -c $qsConfig ipc call cliphistService update'")
+    hl.exec_cmd("wl-paste --type text --watch bash -c 'cliphist store && cliphist list | tail -n +21 | cliphist delete && qs -c $qsConfig ipc call cliphistService update'")
+    hl.exec_cmd("wl-paste --type image --watch bash -c 'cliphist store && cliphist list | tail -n +21 | cliphist delete && qs -c $qsConfig ipc call cliphistService update'")
 
     -- Cursor
     hl.exec_cmd("hyprctl setcursor Bibata-Modern-Classic 24")
+
+    -- Plugins
+    hl.exec_cmd("exec-once = hyprpm reload -n")
 end)
