+    return f"#{r:02X}{g:02X}{b:02X}"
+
+def darken_ini(path, boost, strip_hash=False):
+    if not os.path.exists(path): return
+    lines = open(path).readlines()
+    result = []
+    for line in lines:
+        # Skip ColorSchemeHash so plasma-apply-colorscheme sees it as "new"
+        if strip_hash and line.startswith('ColorSchemeHash='):
+            continue
+        m = re.match(r'((?:Background|Inactive\.Background)(?:Normal|Alternate))=(#[0-9a-fA-F]{6})$', line.strip())
+        if m:
+            result.append(f"{m.group(1)}={darken(m.group(2), boost)}\n")
+        else:
+            result.append(line)
+    open(path, 'w').writelines(result)
+
+color_dir, kdeglobals, boost = sys.argv[1], sys.argv[2], float(sys.argv[3])
