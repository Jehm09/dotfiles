+    // El geocoding solo entiende nombres de lugar ("Palmira", no "Palmira valle del cauca"):
+    // se prueba con cada vez menos palabras y las sobrantes desempatan contra región/país.
+    function resolveCity(cityText, onResolved) {
+        const words = cityText.replace(/,/g, " ").trim().split(/\s+/).filter(word => word.length > 0);
+        const tryWithWordCount = wordCount => {
+            if (wordCount === 0) {
+                console.error(`[WeatherService] Could not find the city "${cityText}".`);
+                return;
+            }
+            const name = words.slice(0, wordCount).join(" ");
+            const hints = words.slice(wordCount).map(normalizeText);
+            getJson(`${root.geocodingUrl}?name=${encodeURIComponent(name)}&count=10&language=${root.language}`, response => {
+                const results = response?.results ?? [];
+                if (results.length === 0) {
+                    tryWithWordCount(wordCount - 1);
+                    return;
+                }
+                const score = place => {
+                    const placeText = normalizeText([place.admin1, place.admin2, place.admin3, place.country].join(" "));
+                    return hints.filter(hint => placeText.includes(hint)).length;
+                };
+                // Ante empate gana el primero: la API ordena por población
+                let best = results[0];
+                for (const place of results) {
+                    if (score(place) > score(best))
