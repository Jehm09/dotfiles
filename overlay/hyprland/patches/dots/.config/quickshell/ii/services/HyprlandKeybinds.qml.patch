+    function parseBinds(text: string): list<var> {
+        const binds = []
+        let current = null
+        const lines = text.split("\n")
+        for (let i = 0; i < lines.length; i++) {
+            const line = lines[i]
+            if (line.startsWith("bind")) {
+                current = {
+                    "modmask": 0,
+                    "submap": "",
+                    "key": "",
+                    "keycode": 0,
+                    "catchall": false,
+                    "description": "",
+                    "dispatcher": "",
+                    "arg": "",
+                }
+                binds.push(current)
+                continue
+            }
+            if (!current || !line.startsWith("\t")) continue
+            const separator = line.indexOf(":")
+            if (separator === -1) continue
+            const field = line.substring(1, separator)
+            const value = line.substring(separator + 1).trim()
+            if (root.intFields.includes(field)) {
+                current[field] = parseInt(value) || 0
+            } else if (field === "catchall") {
+                current[field] = (value === "true")
+            } else {
+                current[field] = value
+            }
+        }
+        return binds
+    }
