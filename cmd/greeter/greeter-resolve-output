#!/usr/bin/env python3
"""Resolve a monitor description to the connector name it currently has.

Connector names (DP-3, HDMI-A-1...) are assigned by the kernel and are not
stable: a GPU driver update renumbers them — nvidia-open 615 renamed DP-4/DP-5
to DP-2/DP-3 on this machine — and so does moving the cable to another port.
The EDID the monitor reports about itself does not change.

Reads /sys/class/drm directly rather than asking a compositor, which is what
lets the greeter use this before any session exists.

Usage:
    greeter-resolve-output "Samsung Electric Company LC32G5xT HNTT800017"
    greeter-resolve-output --list

Exits 1 when nothing matches, so callers can fall back to leaving every output
enabled.
"""

import sys
from pathlib import Path

DRM = Path("/sys/class/drm")


def edid_fields(blob):
    """(product name, serial string, serial hex) from an EDID base block.

    The four 18-byte descriptors start at offset 54. One tagged 0xFC carries the
    product name, one tagged 0xFF the serial as text; the numeric serial always
    sits at bytes 12-15. Hyprland builds its description from the name plus
    whichever serial exists, so matching on both covers either spelling.
    """
    if len(blob) < 128:
        return "", "", ""
    name = serial_str = ""
    for off in (54, 72, 90, 108):
        d = blob[off:off + 18]
        if len(d) < 18 or d[0:3] != b"\x00\x00\x00":
            continue
        text = d[5:18].split(b"\x0a")[0].decode("ascii", "ignore").strip()
        if d[3] == 0xFC:
            name = text
        elif d[3] == 0xFF:
            serial_str = text
    serial_num = int.from_bytes(blob[12:16], "little")
    return name, serial_str, "0x%08X" % serial_num


def connectors():
    for d in sorted(DRM.glob("card*-*")):
        try:
            if (d / "status").read_text().strip() != "connected":
                continue
            blob = (d / "edid").read_bytes()
        except OSError:
            continue
        if not blob:
            continue
        yield (d.name.split("-", 1)[1],) + edid_fields(blob)


def resolve(wanted):
    w = wanted.strip().lower()
    if not w:
        return None
    cons = list(connectors())

    # An explicit connector name still works, so older configs keep resolving.
    for name, _, _, _ in cons:
        if name.lower() == w:
            return name
    # Model plus serial: the strongest match, and the only one that tells two
    # identical monitors apart.
    for name, model, ser, serhex in cons:
        if model and model.lower() in w and (
            (ser and ser.lower() in w) or serhex.lower() in w
        ):
            return name
    # Model alone, for a description recorded without a serial.
    for name, model, _, _ in cons:
        if model and model.lower() in w:
            return name
    return None


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        for name, model, ser, serhex in connectors():
            print(f"{name}\t{model}\t{ser}\t{serhex}")
        sys.exit(0)
    if len(sys.argv) != 2:
        print("usage: greeter-resolve-output <description> | --list", file=sys.stderr)
        sys.exit(2)
    got = resolve(sys.argv[1])
    if not got:
        sys.exit(1)
    print(got)
